{
  // DROPLINE — Cloudflare Worker (not Pages)
  "name": "dropline",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dropline",
      // STEP 3 in README: paste your D1 database ID here
      "database_id": "PASTE-YOUR-D1-DATABASE-ID-HERE"
    }
  ],
  "observability": { "enabled": true }
}
